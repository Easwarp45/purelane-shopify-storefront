                <path d="M629 1015 Q752 1061 875 1028 Q998 1037 1121 1044 Q1244 983 1367 1019 Q1490 972 1613 988 Q1736 1020 1859 993 Q1982 1060 2105 1028" stroke="url(#cg)" stroke-width="4.8" fill="none" opacity="0.19" stroke-linecap="round"/>
