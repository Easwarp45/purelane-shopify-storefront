                <path d="M-20 1118 Q114 1112 249 1129 Q384 1090 518 1109 Q653 1106 787 1101 Q922 1138 1056 1116 Q1191 1142 1325 1134 Q1460 1113 1594 1130 Q1729 1090 1863 1109" stroke="url(#cg)" stroke-width="3.5" fill="none" opacity="0.37" stroke-linecap="round"/>
