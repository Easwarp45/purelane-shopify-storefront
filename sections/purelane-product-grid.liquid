<section class="sec" id="shop" data-scene="2">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>
    
    <div class="shelf">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- assign rendered_count = 0 -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign handle_down = product.handle | downcase
            assign title_down = product.title | downcase
            assign is_unrelated = false
            if handle_down contains 'snowboard' or title_down contains 'snowboard'
              assign is_unrelated = true
            elsif handle_down contains 'ski-wax' or title_down contains 'ski-wax' or title_down contains 'selling plans' or handle_down contains 'selling-plans'
              assign is_unrelated = true
            elsif handle_down contains 'gift-card' or title_down contains 'gift card'
              assign is_unrelated = true
            endif
          -%}
          {%- unless is_unrelated -%}
            {%- render 'purelane-product-card', card_product: product -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            {%- if rendered_count >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- if rendered_count == 0 -%}
          <p class="lede" style="grid-column: 1/-1; text-align: center; color: var(--paper-2);">Add Purelane products to the selected collection.</p>
        {%- endif -%}
      {%- else -%}
        <!-- Hardcoded brand product showcase when no collection is configured -->
        {%- assign showcase_products = "kitchen,dish,tap,laundry,toilet,floor,handwash,wm" | split: "," -%}
        {%- assign showcase_names = "Foaming Kitchen Cleaner,Dishwash Gel,Tap & Limescale Remover,Laundry Detergent,Toilet Cleaner,Floor Cleaner,Hand Wash,Washing Machine Cleaner" | split: "," -%}
        {%- assign showcase_prices = "₹200,₹199,₹249,₹299,₹149,₹179,₹189,₹229" | split: "," -%}
        {%- assign showcase_compare = "₹299,₹299,₹349,₹449,₹249,₹279,₹279,₹349" | split: "," -%}
        {%- assign showcase_discounts = "33% off,33% off,29% off,33% off,40% off,36% off,32% off,34% off" | split: "," -%}
        {%- assign showcase_badges = "Best seller,Best seller,Best seller,,Best seller,,,Best seller" | split: "," -%}
        {%- assign showcase_imgs = "purelane-kitchen.png,purelane-dish.png,purelane-tap.png,purelane-laundry.png,purelane-toilet.png,purelane-floor.png,purelane-handwash.png,purelane-wm.png" | split: "," -%}
        {%- assign max_show = section.settings.products_to_show | default: 8 -%}
        {%- for i in (0..7) -%}
          {%- if i < max_show -%}
            {%- assign sc_name = showcase_names[i] -%}
            {%- assign sc_price = showcase_prices[i] -%}
            {%- assign sc_compare = showcase_compare[i] -%}
            {%- assign sc_discount = showcase_discounts[i] -%}
            {%- assign sc_badge = showcase_badges[i] -%}
            {%- assign sc_img = showcase_imgs[i] | asset_url -%}
            <article class="glass card rv">
              <div class="shot">
                {%- if sc_badge != blank -%}
                  <span class="pill">{{ sc_badge }}</span>
                {%- else -%}
                  <span class="pill">Sale</span>
                {%- endif -%}
                <img
                  src="{{ sc_img }}"
                  class="pimg"
                  alt="{{ sc_name }}"
                  loading="lazy"
                  width="300"
                  height="375"
                  style="height: 122px; width: auto; object-fit: contain;"
                >
              </div>
              <h4 style="margin-top: 10px;"><a href="#shop">{{ sc_name }}</a></h4>
              <div class="rate"><b>★ 4.8</b> · 250+ reviews</div>
              <div class="pr">
                <strong>{{ sc_price }}</strong>
                <s>{{ sc_compare }}</s>
                <em>{{ sc_discount }}</em>
              </div>
              <a href="#shop" class="btn btn-ghost btn-sm" style="width: 100%; justify-content: center;">Shop now</a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Product Grid",
  "tag": "section",
  "class": "section-purelane-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Explore the range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}
