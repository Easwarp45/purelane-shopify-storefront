{%- style -%}
  #purelane-ticker-{{ section.id }} {
    display: {% if section.settings.show_ticker %}block{% else %}none{% endif %};
  }
{%- endstyle -%}

<div class="ticker" aria-hidden="true" id="purelane-ticker-{{ section.id }}">
  <div class="track">
    {%- assign has_announcements = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'announcement' -%}
        {%- assign has_announcements = true -%}
        <span>{{ block.settings.text }}</span>
      {%- endif -%}
    {%- endfor -%}
    <!-- Duplicate copy for seamless infinite marquee scroll -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'announcement' -%}
        <span>{{ block.settings.text }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if has_announcements == false -%}
      <!-- Default fallback announcements if no custom blocks are configured -->
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
      <!-- Duplicate copy for seamless infinite marquee scroll -->
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
    {%- endif -%}
  </div>
</div>

<header id="hdr" class="purelane-header-container">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="Purelane home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.logo_text | default: "Purelane" }}</span>
        <span class="n2">{{ section.settings.logo_subtext | default: "Clean, simply" }}</span>
      </span>
    </a>
    
    <nav class="nav" aria-label="Main">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- liquid
          assign target_url = link.url
          assign title_down = link.title | downcase
          if title_down == 'catalog' or title_down == 'shop' or link.url contains '/collections/all'
            assign target_url = '/#shop'
          elsif title_down == 'home'
            assign target_url = '/#top'
          elsif title_down == 'combos'
            assign target_url = '/#combos'
          elsif title_down == 'bundles'
            assign target_url = '/#bundles'
          elsif title_down == 'reviews' or title_down == 'voices'
            assign target_url = '/#reviews'
          endif
        -%}
        <a href="{{ target_url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    
    <div class="navtools">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ico hide-s" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
        </a>
      {%- endif -%}
      
      <a href="{{ routes.cart_url }}" class="ico" id="cart-icon-bubble" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      
      <button class="ico burger" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Purelane Header",
  "tag": "section",
  "class": "section-purelane-header",
  "settings": [
    {
      "type": "header",
      "content": "Promo Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show Announcement Ticker",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo Branding"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "logo_subtext",
      "label": "Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu Selector",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Tools Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Text",
      "settings": [
        {
          "type": "liquid",
          "id": "text",
          "label": "Announcement Text (HTML allowed)",
          "default": "Free shipping <b>on every bundle across India</b>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping <b>on every bundle across India</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "100% plant-based <b>and non-toxic</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Loved by <b>30,000+ happy homes</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Buy 3 <b>at flat ₹499</b>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
