    elsif cls == 'p-wm'
      assign s2_img_1_url = 'purelane-wm.png' | asset_url
    elsif cls == 'p-toilet'
      assign s2_img_1_url = 'purelane-toilet.png' | asset_url
    elsif cls == 'p-floor'
