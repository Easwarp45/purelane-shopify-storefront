<section class="hero" data-scene="1" id="purelane-hero-{{ section.id }}">
  <div class="hero-grid">
    <!-- Desktop Promise Badges -->
    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_1_text | default: "Plant<br>powered" }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_2_text | default: "Safe for<br>kids & pets" }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span>{{ section.settings.badge_3_text | default: "Zero harsh<br>chemicals" }}</span>
      </div>
    </div>

    <!-- Hero Left Copy -->
    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading }}</h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading }}</p>
      
      <div class="hero-cta rv rv-d3">
        {%- if section.settings.button_1_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_1_link | default: '#shop' }}">
            {{ section.settings.button_1_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link | default: '#how' }}">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Promise Badges Strip -->
      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:18px; height:18px; margin:0 auto 6px; color:#4f7d10;">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          {{ section.settings.badge_1_text_mobile | default: "Plant powered" }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:18px; height:18px; margin:0 auto 6px; color:#4f7d10;">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          {{ section.settings.badge_2_text_mobile | default: "Safe for kids" }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:18px; height:18px; margin:0 auto 6px; color:#4f7d10;">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          {{ section.settings.badge_3_text_mobile | default: "Non-toxic" }}
        </div>
      </div>
    </div>

    <!-- Hero Carousel (Product Staging) -->
    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        
        <!-- Slide 1: 1-Product State -->
        <div class="hslide hs1 on">
          <img src="{{ s1_img_url }}" class="hp a d1" alt="{{ s1_title | escape }}" width="{{ s1_w }}" height="{{ s1_h }}" style="height: 380px; width: auto; object-fit: contain; margin: 0 auto;">
          
          <div class="glass-2 ptag">
            <span class="lbl">{{ s1_title }}</span>
            <div class="val">
              <strong>{{ s1_price }}</strong>
              {%- if s1_compare != blank -%}
                <s>{{ s1_compare }}</s>
              {%- endif -%}
            </div>
            {%- if section.settings.slide_1_badge != blank -%}
              <span class="cut">{{ section.settings.slide_1_badge }}</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Slide 2: 2-Product State -->
        <div class="hslide hs2">
          <img src="{{ s2_img_1_url }}" class="hp a d1" alt="Product 1" width="{{ s2_img_1_w }}" height="{{ s2_img_1_h }}" style="height: 340px; width: auto; object-fit: contain;">
          <img src="{{ s2_img_2_url }}" class="hp b d2" alt="Product 2" width="{{ s2_img_2_w }}" height="{{ s2_img_2_h }}" style="height: 340px; width: auto; object-fit: contain;">
          
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide_2_title }}</span>
            <div class="val">
              <strong>{{ section.settings.slide_2_price }}</strong>
              {%- if section.settings.slide_2_compare != blank -%}
                <s>{{ section.settings.slide_2_compare }}</s>
              {%- endif -%}
            </div>
            {%- if section.settings.slide_2_badge != blank -%}
              <span class="cut">{{ section.settings.slide_2_badge }}</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Slide 3: 3-Product State -->
        <div class="hslide hs3">
          <img src="{{ s3_img_1_url }}" class="hp a d1" alt="Product 1" width="{{ s3_img_1_w }}" height="{{ s3_img_1_h }}" style="height: 300px; width: auto; object-fit: contain;">
          <img src="{{ s3_img_2_url }}" class="hp b d2" alt="Product 2" width="{{ s3_img_2_w }}" height="{{ s3_img_2_h }}" style="height: 300px; width: auto; object-fit: contain;">
          <img src="{{ s3_img_3_url }}" class="hp c d3" alt="Product 3" width="{{ s3_img_3_w }}" height="{{ s3_img_3_h }}" style="height: 300px; width: auto; object-fit: contain;">
          
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide_3_title }}</span>
            <div class="val">
              <strong>{{ section.settings.slide_3_price }}</strong>
              {%- if section.settings.slide_3_compare != blank -%}
                <s>{{ section.settings.slide_3_compare }}</s>
              {%- endif -%}
            </div>
            {%- if section.settings.slide_3_badge != blank -%}
              <span class="cut">{{ section.settings.slide_3_badge }}</span>
            {%- endif -%}
          </div>
        </div>

      </div>
      
      <!-- Dots Controls -->
      <div class="hdots" id="hdots">
        <button class="on" aria-label="Show 1 product"></button>
        <button aria-label="Show 2 products"></button>
        <button aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "section-purelane-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Copy Settings"
    },
    {
      "type": "liquid",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That<br><span class=\"lime\">Lasts</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "button_1_label",
