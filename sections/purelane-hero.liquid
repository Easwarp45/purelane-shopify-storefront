{%- liquid
  assign resolved_kitchen = nil
  assign resolved_tap = nil
  assign resolved_laundry = nil
  assign resolved_toilet = nil
  assign resolved_floor = nil
  assign resolved_dish = nil
  assign resolved_wm = nil

  for p in collections.all.products
    assign title_down = p.title | downcase
    assign handle_down = p.handle | downcase
    if title_down contains 'kitchen' or handle_down contains 'kitchen'
      assign resolved_kitchen = p
    elsif title_down contains 'tap' or title_down contains 'limescale' or handle_down contains 'tap' or handle_down contains 'limescale'
      assign resolved_tap = p
    elsif title_down contains 'laundry' or handle_down contains 'laundry'
      assign resolved_laundry = p
    elsif title_down contains 'toilet' or handle_down contains 'toilet'
      assign resolved_toilet = p
    elsif title_down contains 'floor' or handle_down contains 'floor'
      assign resolved_floor = p
    elsif title_down contains 'dish' or handle_down contains 'dish'
      assign resolved_dish = p
    elsif title_down contains 'washing' or title_down contains 'machine' or handle_down contains 'washing' or handle_down contains 'machine'
      assign resolved_wm = p
    endif
  endfor

  assign s1_image = section.settings.slide_1_image
  if s1_image == blank and resolved_kitchen != blank
    assign s1_image = resolved_kitchen.featured_image
  endif
  assign s1_title = section.settings.slide_1_title
  if s1_title == 'Foaming kitchen cleaner' and resolved_kitchen != blank
    assign s1_title = resolved_kitchen.title
  endif
  assign s1_price = section.settings.slide_1_price
  if s1_price == '₹200' and resolved_kitchen != blank
    assign s1_price = resolved_kitchen.price | money_without_trailing_zeros
  endif
  assign s1_compare = section.settings.slide_1_compare
  if s1_compare == '₹299' and resolved_kitchen != blank
    if resolved_kitchen.compare_at_price > resolved_kitchen.price
      assign s1_compare = resolved_kitchen.compare_at_price | money_without_trailing_zeros
    else
      assign s1_compare = ''
    endif
  endif

  assign s2_img_1 = section.settings.slide_2_img_1
  if s2_img_1 == blank and resolved_kitchen != blank
    assign s2_img_1 = resolved_kitchen.featured_image
  endif
  assign s2_img_2 = section.settings.slide_2_img_2
  if s2_img_2 == blank and resolved_dish != blank
    assign s2_img_2 = resolved_dish.featured_image
  endif

  assign s3_img_1 = section.settings.slide_3_img_1
  if s3_img_1 == blank and resolved_kitchen != blank
    assign s3_img_1 = resolved_kitchen.featured_image
  endif
  assign s3_img_2 = section.settings.slide_3_img_2
  if s3_img_2 == blank and resolved_dish != blank
    assign s3_img_2 = resolved_dish.featured_image
  endif
  assign s3_img_3 = section.settings.slide_3_img_3
  if s3_img_3 == blank and resolved_tap != blank
    assign s3_img_3 = resolved_tap.featured_image
  endif

  assign s1_img_url = nil
  if s1_image != blank
    assign s1_img_url = s1_image | image_url: width: 400
    assign s1_w = s1_image.width
    assign s1_h = s1_image.height
  else
    assign cls = section.settings.slide_1_class | default: 'p-kitchen'
    if cls == 'p-kitchen' or cls == 'p-combo2' or cls == 'p-kbtl'
      assign s1_img_url = 'purelane-kitchen.png' | asset_url
    elsif cls == 'p-dish'
      assign s1_img_url = 'purelane-dish.png' | asset_url
    elsif cls == 'p-tap' or cls == 'p-tbtl'
      assign s1_img_url = 'purelane-tap.png' | asset_url
    elsif cls == 'p-laundry' or cls == 'p-mbtl'
      assign s1_img_url = 'purelane-laundry.png' | asset_url
    elsif cls == 'p-wm'
      assign s1_img_url = 'purelane-wm.png' | asset_url
    elsif cls == 'p-toilet'
      assign s1_img_url = 'purelane-toilet.png' | asset_url
    elsif cls == 'p-floor'
      assign s1_img_url = 'purelane-floor.png' | asset_url
    elsif cls == 'p-handwash'
      assign s1_img_url = 'purelane-handwash.png' | asset_url
    elsif cls == 'p-eraser'
      assign s1_img_url = 'purelane-eraser.png' | asset_url
    else
      assign s1_img_url = 'purelane-kitchen.png' | asset_url
    endif
    assign s1_w = 400
    assign s1_h = 500
  endif

  assign s2_img_1_url = nil
  if s2_img_1 != blank
    assign s2_img_1_url = s2_img_1 | image_url: width: 350
    assign s2_img_1_w = s2_img_1.width
    assign s2_img_1_h = s2_img_1.height
  else
    assign cls = section.settings.slide_2_class_1 | default: 'p-kitchen'
    if cls == 'p-kitchen' or cls == 'p-combo2' or cls == 'p-kbtl'
