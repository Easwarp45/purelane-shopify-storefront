<!-- Purelane Best Selling Combos Section -->
<section class="sec" id="combos" data-scene="2">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="lede" style="margin: 12px auto 0;">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    
    <div class="comborail">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo' -%}
          {%- render 'purelane-combo-card',
            title: block.settings.title,
            products_count: block.settings.products_count,
            benefits: block.settings.benefits,
            price: block.settings.price,
            compare_at_price: block.settings.compare_at_price,
            savings: block.settings.savings,
            badge: block.settings.badge,
            is_hero: block.settings.is_hero,
            product_1_image: block.settings.product_1_image,
            product_1_class: block.settings.product_1_class,
            product_1_label: block.settings.product_1_label,
            product_2_image: block.settings.product_2_image,
            product_2_class: block.settings.product_2_class,
            product_2_label: block.settings.product_2_label,
            product_3_image: block.settings.product_3_image,
            product_3_class: block.settings.product_3_class,
            product_3_label: block.settings.product_3_label,
            product_4_image: block.settings.product_4_image,
            product_4_class: block.settings.product_4_class,
            product_4_label: block.settings.product_4_label,
            product_5_image: block.settings.product_5_image,
            product_5_class: block.settings.product_5_class,
            product_5_label: block.settings.product_5_label,
            button_link: block.settings.button_link,
            button_label: block.settings.button_label
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    {%- if section.settings.show_swipecue -%}
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        <span>Swipe to see all combos</span>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best Selling Combos",
  "tag": "section",
  "class": "section-purelane-best-selling-combos",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "checkbox",
      "id": "show_swipecue",
      "label": "Show swipe cue on mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Highlight combo (Hero style)",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Flag/Badge (e.g. Most popular)"
        },
        {
          "type": "text",
          "id": "savings",
          "label": "Savings Badge (e.g. Save ₹398)",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "number",
          "id": "products_count",
          "label": "Number of products",
          "default": 3
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "Bullet Benefits (Separate with middot ·)",
          "default": "Cuts grease instantly · Squeaky clean dishes · Melts hard water stains"
        },
        {
          "type": "number",
          "id": "price",
          "label": "Combo Price (INR)",
          "default": 499
        },
        {
          "type": "number",
          "id": "compare_at_price",
          "label": "Compare At Price (INR)",
          "default": 897
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Product Stack configuration"
        },
        {
          "type": "image_picker",
          "id": "product_1_image",
          "label": "Product 1 Image"
        },
        {
          "type": "text",
          "id": "product_1_class",
          "label": "Product 1 Fallback SVG class",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "product_1_label",
          "label": "Product 1 Label",
          "default": "Kitchen"
        },
        {
          "type": "image_picker",
          "id": "product_2_image",
          "label": "Product 2 Image"
        },
        {
          "type": "text",
          "id": "product_2_class",
          "label": "Product 2 Fallback SVG class",
          "default": "p-dish"
        },
        {
          "type": "text",
          "id": "product_2_label",
          "label": "Product 2 Label",
          "default": "Dishwash"
        },
        {
          "type": "image_picker",
          "id": "product_3_image",
          "label": "Product 3 Image"
        },
        {
          "type": "text",
          "id": "product_3_class",
          "label": "Product 3 Fallback SVG class",
          "default": "p-tap"
        },
        {
          "type": "text",
          "id": "product_3_label",
          "label": "Product 3 Label",
          "default": "Tap clean"
        },
        {
          "type": "image_picker",
          "id": "product_4_image",
          "label": "Product 4 Image"
        },
        {
          "type": "text",
          "id": "product_4_class",
          "label": "Product 4 Fallback SVG class"
        },
        {
          "type": "text",
          "id": "product_4_label",
          "label": "Product 4 Label"
        },
        {
          "type": "image_picker",
          "id": "product_5_image",
          "label": "Product 5 Image"
        },
        {
          "type": "text",
          "id": "product_5_class",
          "label": "Product 5 Fallback SVG class"
        },
        {
          "type": "text",
          "id": "product_5_label",
          "label": "Product 5 Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Selling Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen essentials",
            "is_hero": true,
            "badge": "Most popular",
            "savings": "Save ₹398",
            "price": 499,
            "compare_at_price": 897,
            "product_1_class": "p-kitchen",
            "product_1_label": "Kitchen",
            "product_2_class": "p-dish",
            "product_2_label": "Dishwash",
            "product_3_class": "p-tap",
