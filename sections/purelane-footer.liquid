<footer data-scene="4" class="purelane-footer-section">
  <div class="wrap">
    <div class="fgrid">
      <!-- Column 1: Brand -->
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              <path d="M12 21v-6"/>
            </svg>
          </span>
          <span class="txt">
            <span class="n1">{{ section.settings.brand_name | default: "Purelane" }}</span>
            <span class="n2">{{ section.settings.brand_tagline | default: "Clean, simply" }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.brand_description | default: "Effective cleaning, powered by nature. Made for Indian homes since day one." }}</p>
      </div>
      
      <!-- Column 2: Shop Menu -->
      <div class="fcol">
        <h5>{{ section.settings.menu_1_title | default: "Shop" }}</h5>
        {%- if section.settings.menu_1 != blank -%}
          {%- for link in linklists[section.settings.menu_1].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#shop">Bestsellers</a>
          <a href="#shop">Kitchen</a>
          <a href="#shop">Laundry</a>
          <a href="#shop">Home</a>
          <a href="#shop">Skin</a>
          <a href="#bundles">Starter kits</a>
        {%- endif -%}
      </div>
      
      <!-- Column 3: About Menu -->
      <div class="fcol">
        <h5>{{ section.settings.menu_2_title | default: "About" }}</h5>
        {%- if section.settings.menu_2 != blank -%}
          {%- for link in linklists[section.settings.menu_2].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#how">How it works</a>
          <a href="#ingredients">Sustainability</a>
          <a href="#proof">FAQs</a>
          <a href="#voices">Reviews</a>
        {%- endif -%}
      </div>
      
      <!-- Column 4: Contact -->
      <div class="fcol">
        <h5>{{ section.settings.contact_title | default: "Get in touch" }}</h5>
        {%- if section.settings.contact_email != blank -%}
          <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
        {%- endif -%}
        {%- if section.settings.contact_phone != blank -%}
          <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}">{{ section.settings.contact_phone }}</a>
        {%- endif -%}
        {%- if section.settings.contact_address != blank -%}
          <p style="font-size:12px;color:rgba(236,230,247,.5)">{{ section.settings.contact_address }}</p>
        {%- endif -%}
      </div>
    </div>
    
    <div class="fbot">
      <span>{{ section.settings.copyright_text | default: "© 2026 Purelane Eco Products Private Limited" }}</span>
      <span>{{ section.settings.footer_links_text | default: "Privacy · Terms · Refunds · Contact" }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "tag": "section",
  "class": "section-purelane-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand Info"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Link List"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 Link List"
    },
    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact Column Title",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@purelane.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 9930 123 234"
    },
    {
      "type": "text",
      "id": "contact_address",
      "label": "Company/Address Details",
      "default": "Purelane Eco Products Pvt Ltd"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Purelane Eco Products Private Limited"
    },
    {
      "type": "text",
      "id": "footer_links_text",
      "label": "Footer Links List",
      "default": "Privacy · Terms · Refunds · Contact"
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer"
    }
  ]
}
{% endschema %}
