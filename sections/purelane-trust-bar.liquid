<section class="sec" data-scene="4" id="purelane-trust-{{ section.id }}">
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="trust-i">
            {%- if block.settings.icon == 'plant' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
            {%- elsif block.settings.icon == 'package' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
            {%- elsif block.settings.icon == 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
            {%- elsif block.settings.icon == 'globe' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/></svg>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Trust Bar",
  "tag": "section",
  "class": "section-purelane-trust-bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Indicator",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "plant", "label": "Plant Leaf" },
            { "value": "package", "label": "Recyclable Box" },
            { "value": "shield", "label": "Safety Heart/Shield" },
            { "value": "globe", "label": "Made in India Globe" }
          ],
          "default": "plant"
        },
        {
          "type": "liquid",
          "id": "text",
          "label": "Label Text (HTML allowed)",
          "default": "Plant derived<br>formulas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Trust Bar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "plant", "text": "Plant derived<br>formulas" } },
        { "type": "trust_item", "settings": { "icon": "package", "text": "Recyclable<br>packaging" } },
        { "type": "trust_item", "settings": { "icon": "shield", "text": "Safe for<br>kids & pets" } },
        { "type": "trust_item", "settings": { "icon": "globe", "text": "Made in<br>India" } }
      ]
    }
  ]
}
{% endschema %}
