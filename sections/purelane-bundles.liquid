          "default": "p-kitchen"
        },
        {
          "type": "image_picker",
          "id": "product_2_image",
          "label": "Product 2 Image"
        },
        {
          "type": "text",
          "id": "product_2_class",
          "label": "Product 2 Fallback class",
          "default": "p-dish"
        },
        {
          "type": "image_picker",
          "id": "product_3_image",
          "label": "Product 3 Image"
        },
        {
          "type": "text",
          "id": "product_3_class",
          "label": "Product 3 Fallback class",
          "default": "p-tap"
        },
        {
          "type": "image_picker",
          "id": "product_4_image",
          "label": "Product 4 Image"
        },
        {
          "type": "text",
          "id": "product_4_class",
          "label": "Product 4 Fallback class"
        },
        {
          "type": "image_picker",
          "id": "product_5_image",
          "label": "Product 5 Image"
        },
        {
          "type": "text",
          "id": "product_5_class",
          "label": "Product 5 Fallback class"
        }
      ]
    }
  ],
