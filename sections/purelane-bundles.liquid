{%- liquid
  # Resolve real products
  assign resolved_kitchen = nil
  assign resolved_tap = nil
  assign resolved_laundry = nil
  assign resolved_toilet = nil
  assign resolved_floor = nil
  assign resolved_dish = nil
  assign resolved_wm = nil

  for p in collections.all.products
    assign title_down = p.title | downcase
    assign handle_down = p.handle | downcase
    if title_down contains 'kitchen' or handle_down contains 'kitchen'
      assign resolved_kitchen = p
    elsif title_down contains 'tap' or title_down contains 'limescale' or handle_down contains 'tap' or handle_down contains 'limescale'
      assign resolved_tap = p
    elsif title_down contains 'laundry' or handle_down contains 'laundry'
      assign resolved_laundry = p
    elsif title_down contains 'toilet' or handle_down contains 'toilet'
      assign resolved_toilet = p
    elsif title_down contains 'floor' or handle_down contains 'floor'
      assign resolved_floor = p
    elsif title_down contains 'dish' or handle_down contains 'dish'
      assign resolved_dish = p
    elsif title_down contains 'washing' or title_down contains 'machine' or handle_down contains 'washing' or handle_down contains 'machine'
      assign resolved_wm = p
    endif
  endfor
-%}

<section class="sec" id="bundles" data-scene="3">
  
  <!-- PART 1: WHY BUNDLES BEAT BUYING SINGLE -->
  <div class="wrap" style="margin-bottom: var(--sec-y);">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.why_kicker | default: "The smarter way to shop" }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.why_heading | default: "Why bundles beat buying single" }}</h2>
      </div>
      <div class="wb">
        {%- for block in section.blocks -%}
          {%- if block.type == 'why_item' -%}
            <div class="wb-i">
              <span class="ci">
                {%- if block.settings.icon == 'money' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
                {%- elsif block.settings.icon == 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
                {%- elsif block.settings.icon == 'shipping' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/></svg>
                {%- endif -%}
              </span>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- PART 2: BUNDLE CATEGORIES -->
  <div class="wrap" style="margin-bottom: var(--sec-y);">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.cat_kicker | default: "Bundle categories" }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.cat_heading | default: "Find the right bundle for you" }}</h2>
    </div>
    <div class="cats">
      {%- assign cat_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- assign delay = "" -%}
          {%- if cat_index == 1 -%}
            {%- assign delay = "rv-d1" -%}
          {%- elsif cat_index == 2 -%}
            {%- assign delay = "rv-d2" -%}
          {%- elsif cat_index == 3 -%}
            {%- assign delay = "rv-d3" -%}
          {%- endif -%}
          
          {%- liquid
            assign cat_image = block.settings.image
            if cat_image == blank
              if block.settings.fallback_class == 'p-kitchen' and resolved_kitchen != blank
                assign cat_image = resolved_kitchen.featured_image
              elsif block.settings.fallback_class == 'p-toilet' and resolved_toilet != blank
                assign cat_image = resolved_toilet.featured_image
              elsif block.settings.fallback_class == 'p-laundry' and resolved_laundry != blank
                assign cat_image = resolved_laundry.featured_image
              elsif block.settings.fallback_class == 'p-tap' and resolved_tap != blank
                assign cat_image = resolved_tap.featured_image
              endif
            endif
          -%}
          
          {%- render 'purelane-bundle-card',
            title: block.settings.title,
            description: block.settings.description,
            link: block.settings.link,
            image: cat_image,
            fallback_class: block.settings.fallback_class,
            delay_class: delay
          -%}
          {%- assign cat_index = cat_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- PART 3: BUNDLE TIERS (STARTER KITS) -->
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.tier_kicker | default: "Simple pricing" }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.tier_heading | default: "Choose your bundle size" }}</h2>
    </div>
    
    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tier' -%}
          <div class="glass tier{% if block.settings.is_best %} best{% endif %} rv">
            {%- if block.settings.badge != blank -%}
              <span class="tag">{{ block.settings.badge }}</span>
            {%- endif -%}
            
            <div class="qty">
              {{ block.settings.qty }}
              <small>{{ block.settings.qty_unit | default: "Products" }}</small>
            </div>
            
            <div class="price">
              ₹{{ block.settings.price }}
              {%- if block.settings.compare_at_price > block.settings.price -%}
                <s>₹{{ block.settings.compare_at_price }}</s>
              {%- endif -%}
            </div>
            
            <!-- Tier Product Staging Stack -->
            <div class="tierpix {% if block.settings.product_4_class != blank or block.settings.product_5_class != blank %}five{% endif %}">
              {%- liquid
                assign p1_img = block.settings.product_1_image
                if p1_img == blank
                  if block.settings.product_1_class == 'p-kitchen' and resolved_kitchen != blank
                    assign p1_img = resolved_kitchen.featured_image
                  elsif block.settings.product_1_class == 'p-combo2' and resolved_kitchen != blank
                    assign p1_img = resolved_kitchen.featured_image
                  endif
                endif

                assign p1_url = nil
                if p1_img != blank
                  assign p1_url = p1_img | image_url: width: 100
                  assign p1_w = p1_img.width
                  assign p1_h = p1_img.height
                else
                  assign cls = block.settings.product_1_class
                  if cls == 'p-kitchen' or cls == 'p-combo2'
                    assign p1_url = 'purelane-kitchen.png' | asset_url
                  elsif cls == 'p-dish'
                    assign p1_url = 'purelane-dish.png' | asset_url
                  elsif cls == 'p-tap'
                    assign p1_url = 'purelane-tap.png' | asset_url
                  elsif cls == 'p-laundry'
                    assign p1_url = 'purelane-laundry.png' | asset_url
                  elsif cls == 'p-wm'
                    assign p1_url = 'purelane-wm.png' | asset_url
                  elsif cls == 'p-toilet'
                    assign p1_url = 'purelane-toilet.png' | asset_url
                  elsif cls == 'p-floor'
                    assign p1_url = 'purelane-floor.png' | asset_url
                  elsif cls == 'p-handwash'
                    assign p1_url = 'purelane-handwash.png' | asset_url
                  elsif cls == 'p-eraser'
                    assign p1_url = 'purelane-eraser.png' | asset_url
                  endif
                  assign p1_w = 100
                  assign p1_h = 125
                endif

                assign p2_img = block.settings.product_2_image
                if p2_img == blank
                  if block.settings.product_2_class == 'p-dish' and resolved_dish != blank
                    assign p2_img = resolved_dish.featured_image
                  endif
                endif

                assign p2_url = nil
                if p2_img != blank
                  assign p2_url = p2_img | image_url: width: 100
                  assign p2_w = p2_img.width
                  assign p2_h = p2_img.height
                else
                  assign cls = block.settings.product_2_class
                  if cls == 'p-kitchen' or cls == 'p-combo2'
                    assign p2_url = 'purelane-kitchen.png' | asset_url
                  elsif cls == 'p-dish'
                    assign p2_url = 'purelane-dish.png' | asset_url
                  elsif cls == 'p-tap'
                    assign p2_url = 'purelane-tap.png' | asset_url
                  elsif cls == 'p-laundry'
                    assign p2_url = 'purelane-laundry.png' | asset_url
                  elsif cls == 'p-wm'
                    assign p2_url = 'purelane-wm.png' | asset_url
                  elsif cls == 'p-toilet'
                    assign p2_url = 'purelane-toilet.png' | asset_url
                  elsif cls == 'p-floor'
                    assign p2_url = 'purelane-floor.png' | asset_url
                  elsif cls == 'p-handwash'
                    assign p2_url = 'purelane-handwash.png' | asset_url
                  elsif cls == 'p-eraser'
                    assign p2_url = 'purelane-eraser.png' | asset_url
                  endif
                  assign p2_w = 100
                  assign p2_h = 125
                endif

                assign p3_img = block.settings.product_3_image
                if p3_img == blank
                  if block.settings.product_3_class == 'p-tap' and resolved_tap != blank
                    assign p3_img = resolved_tap.featured_image
                  endif
                endif

                assign p3_url = nil
                if p3_img != blank
                  assign p3_url = p3_img | image_url: width: 100
                  assign p3_w = p3_img.width
                  assign p3_h = p3_img.height
                else
                  assign cls = block.settings.product_3_class
                  if cls == 'p-kitchen' or cls == 'p-combo2'
                    assign p3_url = 'purelane-kitchen.png' | asset_url
                  elsif cls == 'p-dish'
                    assign p3_url = 'purelane-dish.png' | asset_url
                  elsif cls == 'p-tap'
                    assign p3_url = 'purelane-tap.png' | asset_url
                  elsif cls == 'p-laundry'
                    assign p3_url = 'purelane-laundry.png' | asset_url
                  elsif cls == 'p-wm'
                    assign p3_url = 'purelane-wm.png' | asset_url
                  elsif cls == 'p-toilet'
                    assign p3_url = 'purelane-toilet.png' | asset_url
                  elsif cls == 'p-floor'
                    assign p3_url = 'purelane-floor.png' | asset_url
                  elsif cls == 'p-handwash'
                    assign p3_url = 'purelane-handwash.png' | asset_url
                  elsif cls == 'p-eraser'
                    assign p3_url = 'purelane-eraser.png' | asset_url
                  endif
                  assign p3_w = 100
                  assign p3_h = 125
                endif

                assign p4_img = block.settings.product_4_image
                if p4_img == blank
                  if block.settings.product_4_class == 'p-floor' and resolved_floor != blank
                    assign p4_img = resolved_floor.featured_image
                  endif
                endif

                assign p4_url = nil
                if p4_img != blank
                  assign p4_url = p4_img | image_url: width: 100
                  assign p4_w = p4_img.width
                  assign p4_h = p4_img.height
                else
                  assign cls = block.settings.product_4_class
                  if cls == 'p-kitchen' or cls == 'p-combo2'
                    assign p4_url = 'purelane-kitchen.png' | asset_url
                  elsif cls == 'p-dish'
                    assign p4_url = 'purelane-dish.png' | asset_url
                  elsif cls == 'p-tap'
                    assign p4_url = 'purelane-tap.png' | asset_url
                  elsif cls == 'p-laundry'
                    assign p4_url = 'purelane-laundry.png' | asset_url
                  elsif cls == 'p-wm'
                    assign p4_url = 'purelane-wm.png' | asset_url
                  elsif cls == 'p-toilet'
                    assign p4_url = 'purelane-toilet.png' | asset_url
                  elsif cls == 'p-floor'
                    assign p4_url = 'purelane-floor.png' | asset_url
                  elsif cls == 'p-handwash'
                    assign p4_url = 'purelane-handwash.png' | asset_url
                  elsif cls == 'p-eraser'
                    assign p4_url = 'purelane-eraser.png' | asset_url
                  endif
                  assign p4_w = 100
                  assign p4_h = 125
                endif

                assign p5_img = block.settings.product_5_image
                if p5_img == blank
                  if block.settings.product_5_class == 'p-laundry' and resolved_laundry != blank
                    assign p5_img = resolved_laundry.featured_image
                  elsif block.settings.product_5_class == 'p-handwash' and resolved_dish != blank
                    assign p5_img = resolved_dish.featured_image
                  endif
                endif

                assign p5_url = nil
                if p5_img != blank
                  assign p5_url = p5_img | image_url: width: 100
                  assign p5_w = p5_img.width
                  assign p5_h = p5_img.height
                else
                  assign cls = block.settings.product_5_class
                  if cls == 'p-kitchen' or cls == 'p-combo2'
                    assign p5_url = 'purelane-kitchen.png' | asset_url
                  elsif cls == 'p-dish'
                    assign p5_url = 'purelane-dish.png' | asset_url
                  elsif cls == 'p-tap'
                    assign p5_url = 'purelane-tap.png' | asset_url
                  elsif cls == 'p-laundry'
                    assign p5_url = 'purelane-laundry.png' | asset_url
                  elsif cls == 'p-wm'
                    assign p5_url = 'purelane-wm.png' | asset_url
                  elsif cls == 'p-toilet'
                    assign p5_url = 'purelane-toilet.png' | asset_url
                  elsif cls == 'p-floor'
                    assign p5_url = 'purelane-floor.png' | asset_url
                  elsif cls == 'p-handwash'
                    assign p5_url = 'purelane-handwash.png' | asset_url
                  elsif cls == 'p-eraser'
                    assign p5_url = 'purelane-eraser.png' | asset_url
                  endif
                  assign p5_w = 100
                  assign p5_h = 125
                endif
              -%}

              {%- if p1_url != blank -%}
                <img src="{{ p1_url }}" class="pimg" alt="P1" loading="lazy" width="{{ p1_w }}" height="{{ p1_h }}" style="height: 54px; width: auto; object-fit: contain;">
              {%- elsif block.settings.product_1_class != blank -%}
                <span class="pimg {{ block.settings.product_1_class }}" role="img"></span>
              {%- endif -%}

              {%- if p2_url != blank -%}
                <img src="{{ p2_url }}" class="pimg" alt="P2" loading="lazy" width="{{ p2_w }}" height="{{ p2_h }}" style="height: 54px; width: auto; object-fit: contain;">
              {%- elsif block.settings.product_2_class != blank -%}
                <span class="pimg {{ block.settings.product_2_class }}" role="img"></span>
              {%- endif -%}

              {%- if p3_url != blank -%}
                <img src="{{ p3_url }}" class="pimg" alt="P3" loading="lazy" width="{{ p3_w }}" height="{{ p3_h }}" style="height: 54px; width: auto; object-fit: contain;">
              {%- elsif block.settings.product_3_class != blank -%}
                <span class="pimg {{ block.settings.product_3_class }}" role="img"></span>
              {%- endif -%}

              {%- if p4_url != blank -%}
                <img src="{{ p4_url }}" class="pimg" alt="P4" loading="lazy" width="{{ p4_w }}" height="{{ p4_h }}" style="height: 54px; width: auto; object-fit: contain;">
              {%- elsif block.settings.product_4_class != blank -%}
                <span class="pimg {{ block.settings.product_4_class }}" role="img"></span>
              {%- endif -%}

              {%- if p5_url != blank -%}
                <img src="{{ p5_url }}" class="pimg" alt="P5" loading="lazy" width="{{ p5_w }}" height="{{ p5_h }}" style="height: 54px; width: auto; object-fit: contain;">
              {%- elsif block.settings.product_5_class != blank -%}
                <span class="pimg {{ block.settings.product_5_class }}" role="img"></span>
              {%- endif -%}
            </div>
            
            <!-- Features Checklist -->
            <ul>
              {%- assign features_array = block.settings.features | split: "," -%}
              {%- for feature in features_array -%}
                {%- if feature != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {{ feature | strip }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            
            <a href="{{ block.settings.button_link | default: '#shop' }}" class="btn btn-primary" style="width: 100%; justify-content: center;">
              {{ block.settings.button_label | default: "Shop Kit" }}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "section-purelane-bundles",
  "settings": [
    {
      "type": "header",
      "content": "Why Bundles beat single Settings"
    },
    {
      "type": "text",
      "id": "why_kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    },
    {
      "type": "header",
      "content": "Category Settings"
    },
    {
      "type": "text",
      "id": "cat_kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "cat_heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    },
    {
      "type": "header",
      "content": "Tiers / Starter Kits Settings"
    },
    {
      "type": "text",
      "id": "tier_kicker",
      "label": "Kicker",
      "default": "Simple pricing"
    },
    {
      "type": "text",
