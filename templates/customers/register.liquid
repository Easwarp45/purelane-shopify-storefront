{{ 'customer.css' | asset_url | stylesheet_tag }}

<style>
  .customer-register-container {
    max-width: 480px;
    margin: 80px auto 100px;
    padding: 0 16px;
    font-family: 'Inter', sans-serif;
  }

  .register-card {
    background: var(--g-bg);
    border: 1px solid var(--g-line);
    border-radius: var(--r);
    padding: 40px 30px;
    box-shadow: var(--g-shadow);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .register-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,0.4), transparent);
  }

  .register-card > * {
    position: relative;
    z-index: 1;
  }

  .register-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
  }

  .register-logo .mark {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, rgba(201, 118, 29, .20), rgba(75, 58, 143, .14));
    border: 1px solid rgba(75, 58, 143, .18);
  }

  .register-logo .mark svg {
    width: 20px;
    height: 20px;
    color: #b8701c;
  }

  .register-logo .txt {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand);
  }

  .register-card h1 {
    font-family: 'Outfit', sans-serif;
    text-transform: uppercase;
    font-size: 26px;
    font-weight: 800;
    color: var(--surface);
    margin: 0 0 10px;
  }

  .register-card p {
    font-size: 14px;
    color: var(--paper-2);
    margin-bottom: 30px;
  }

  /* Form Elements */
  .form-row {
    margin-bottom: 20px;
    text-align: left;
  }

  .form-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--paper-3);
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--g-line);
    border-radius: var(--r-sm);
    font-family: inherit;
    font-size: 14px;
    color: var(--surface);
    transition: all 0.25s var(--ease);
  }

  .form-input:focus {
    outline: none;
    background: #fff;
    border-color: var(--brand);
    box-shadow: 0 0 0 4px rgba(75, 58, 143, 0.1);
  }

  .btn-register {
    width: 100%;
    padding: 14px;
    background: var(--brand);
    color: #fff;
    border-radius: var(--r-sm);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.1em;
    transition: all 0.25s var(--ease);
    box-shadow: 0 4px 14px rgba(75, 58, 143, 0.25);
    margin-top: 10px;
  }

  .btn-register:hover {
    background: var(--brand-lt);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(75, 58, 143, 0.35);
  }

  .register-card-footer {
    margin-top: 30px;
    border-top: 1px solid var(--g-line);
    padding-top: 20px;
    font-size: 13.5px;
    color: var(--paper-2);
  }

  .register-card-footer a {
    color: var(--brand);
    font-weight: 700;
  }

  .register-card-footer a:hover {
    color: var(--brand-lt);
    text-decoration: underline;
  }

  /* Form Errors */
  .errors {
    background: #fff0f0;
    border: 1px solid rgba(217, 56, 56, 0.15);
    border-radius: var(--r-sm);
    padding: 12px 16px;
    color: #d93838;
    margin-bottom: 25px;
    text-align: left;
    font-size: 13px;
  }

  .errors ul {
    margin: 0;
    padding-left: 20px;
  }
</style>

<div class="customer-register-container">
  
  <div class="register-card">
    <div class="register-logo">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
      </span>
      <span class="txt">Purelane</span>
    </div>

    <h1>{{ 'customer.register.title' | t }}</h1>
    <p>Create an account to start tracking orders and earning rewards.</p>

    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-row">
        <label for="RegisterForm-FirstName" class="form-label">{{ 'customer.register.first_name' | t }}</label>
        <input
          type="text"
          name="customer[first_name]"
          id="RegisterForm-FirstName"
          class="form-input"
          {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
          autocomplete="given-name"
          placeholder="e.g. Rahul"
        >
      </div>

      <div class="form-row">
        <label for="RegisterForm-LastName" class="form-label">{{ 'customer.register.last_name' | t }}</label>
        <input
          type="text"
          name="customer[last_name]"
          id="RegisterForm-LastName"
          class="form-input"
          {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
          autocomplete="family-name"
          placeholder="e.g. Sharma"
        >
      </div>

      <div class="form-row">
        <label for="RegisterForm-Email" class="form-label">{{ 'customer.register.email' | t }}</label>
        <input
          type="email"
          name="customer[email]"
          id="RegisterForm-Email"
          class="form-input"
          {% if form.email %}value="{{ form.email }}"{% endif %}
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="rahul@email.com"
          required
        >
      </div>

      <div class="form-row">
        <label for="RegisterForm-Password" class="form-label">{{ 'customer.register.password' | t }}</label>
        <input
          type="password"
          name="customer[password]"
          id="RegisterForm-Password"
          class="form-input"
          autocomplete="new-password"
          placeholder="••••••••"
          required
        >
      </div>

      <button type="submit" class="btn-register">
        {{ 'customer.register.submit' | t }}
      </button>
    {%- endform -%}

    <div class="register-card-footer">
      Already have an account? 
      <a href="{{ routes.account_login_url }}">
        Log in here
      </a>
    </div>
  </div>

</div>
