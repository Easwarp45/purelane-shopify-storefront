{{ 'customer.css' | asset_url | stylesheet_tag }}

<style>
  .customer-login-container {
    max-width: 480px;
    margin: 80px auto 100px;
    padding: 0 16px;
    font-family: 'Inter', sans-serif;
  }

  .login-card {
    background: var(--g-bg);
    border: 1px solid var(--g-line);
    border-radius: var(--r);
    padding: 40px 30px;
    box-shadow: var(--g-shadow);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .login-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,0.4), transparent);
  }

  .login-card > * {
    position: relative;
    z-index: 1;
  }

  .login-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
  }

  .login-logo .mark {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, rgba(201, 118, 29, .20), rgba(75, 58, 143, .14));
    border: 1px solid rgba(75, 58, 143, .18);
  }

  .login-logo .mark svg {
    width: 20px;
    height: 20px;
    color: #b8701c;
  }

  .login-logo .txt {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand);
  }

  .login-card h1 {
    font-family: 'Outfit', sans-serif;
    text-transform: uppercase;
    font-size: 26px;
    font-weight: 800;
    color: var(--surface);
    margin: 0 0 10px;
  }

  .login-card p {
    font-size: 14px;
    color: var(--paper-2);
    margin-bottom: 30px;
  }

  /* Form Elements */
  .form-row {
    margin-bottom: 20px;
    text-align: left;
  }

  .form-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--paper-3);
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--g-line);
    border-radius: var(--r-sm);
    font-family: inherit;
    font-size: 14px;
    color: var(--surface);
    transition: all 0.25s var(--ease);
  }

  .form-input:focus {
    outline: none;
    background: #fff;
    border-color: var(--brand);
    box-shadow: 0 0 0 4px rgba(75, 58, 143, 0.1);
  }

  .form-links {
    display: flex;
    justify-content: flex-end;
    margin-top: -10px;
    margin-bottom: 25px;
  }

  .forgot-link {
    font-size: 12px;
    color: var(--brand);
    font-weight: 600;
  }

  .forgot-link:hover {
    color: var(--brand-lt);
    text-decoration: underline;
  }

  .btn-login {
    width: 100%;
    padding: 14px;
    background: var(--brand);
    color: #fff;
    border-radius: var(--r-sm);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.1em;
    transition: all 0.25s var(--ease);
    box-shadow: 0 4px 14px rgba(75, 58, 143, 0.25);
  }

  .btn-login:hover {
    background: var(--brand-lt);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(75, 58, 143, 0.35);
  }

  .btn-login-secondary {
    background: transparent;
    color: var(--brand);
    border: 1px solid var(--brand);
    box-shadow: none;
    margin-top: 12px;
  }

  .btn-login-secondary:hover {
    background: rgba(75, 58, 143, 0.05);
    color: var(--brand-lt);
    border-color: var(--brand-lt);
    box-shadow: none;
  }

  .login-card-footer {
    margin-top: 30px;
    border-top: 1px solid var(--g-line);
    padding-top: 20px;
    font-size: 13.5px;
    color: var(--paper-2);
  }

  .login-card-footer a {
    color: var(--brand);
    font-weight: 700;
  }

  .login-card-footer a:hover {
    color: var(--brand-lt);
    text-decoration: underline;
  }

  /* Form Errors */
  .errors {
    background: #fff0f0;
    border: 1px solid rgba(217, 56, 56, 0.15);
    border-radius: var(--r-sm);
    padding: 12px 16px;
    color: #d93838;
    margin-bottom: 25px;
    text-align: left;
    font-size: 13px;
  }

  .errors ul {
    margin: 0;
    padding-left: 20px;
  }

  /* Reset Form State Toggle */
  #recover, #recover:target ~ #login {
    display: block;
  }
  #login, #recover:target {
    display: none;
  }
</style>

<div class="customer-login-container">
  
  <!-- PASSWORD RECOVERY FORM -->
  <div id="recover" style="display: none;">
    <div class="login-card">
      <div class="login-logo">
        <span class="mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </span>
        <span class="txt">Purelane</span>
      </div>
      
      <h1>{{ 'customer.recover_password.title' | t }}</h1>
      <p>{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <div class="errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="errors" style="background:#e8f9ec; color:#1e7e34; border-color:rgba(30,126,52,0.15);" role="alert">
            {{ 'customer.recover_password.success' | t }}
          </div>
        {%- endif -%}

        <div class="form-row">
          <label for="RecoverEmail" class="form-label">{{ 'customer.login_page.email' | t }}</label>
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            class="form-input"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="name@email.com"
            required
          >
        </div>

        <button type="submit" class="btn-login">
          {{ 'customer.login_page.submit' | t }}
        </button>

        <a href="#login" class="btn-login btn-login-secondary" style="display: block; text-decoration: none;">
          {{ 'customer.login_page.cancel' | t }}
        </a>
      {%- endform -%}
    </div>
  </div>

  <!-- LOGIN FORM -->
  <div id="login">
    <div class="login-card">
      <div class="login-logo">
        <span class="mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
          </svg>
        </span>
        <span class="txt">Purelane</span>
      </div>

      <h1>{{ 'customer.login_page.title' | t }}</h1>
      <p>Log in to track orders, manage addresses, and check out faster.</p>

      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-row">
          <label for="CustomerEmail" class="form-label">{{ 'customer.login_page.email' | t }}</label>
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            class="form-input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="name@email.com"
            required
          >
        </div>

        {%- if form.password_needed -%}
          <div class="form-row">
            <label for="CustomerPassword" class="form-label">{{ 'customer.login_page.password' | t }}</label>
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              class="form-input"
              autocomplete="current-password"
              placeholder="••••••••"
              required
            >
          </div>

          <div class="form-links">
            <a href="#recover" class="forgot-link">
              {{ 'customer.login_page.forgot_password' | t }}
            </a>
          </div>
        {%- endif -%}

        <button type="submit" class="btn-login">
          {{ 'customer.login_page.sign_in' | t }}
        </button>
      {%- endform -%}

      <div class="login-card-footer">
        Don't have an account? 
        <a href="{{ routes.account_register_url }}">
          {{ 'customer.login_page.create_account' | t }}
        </a>
      </div>
    </div>
  </div>

</div>

<script>
  // Handle toggling if URL contains #recover directly
  if (window.location.hash === '#recover') {
    document.getElementById('recover').style.display = 'block';
    document.getElementById('login').style.display = 'none';
  }
</script>
