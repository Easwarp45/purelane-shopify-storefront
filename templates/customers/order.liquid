{{ 'customer.css' | asset_url | stylesheet_tag }}

<style>
  .customer-order-container {
    max-width: var(--maxw);
    margin: 40px auto 80px;
    padding: 0 16px;
    font-family: 'Inter', sans-serif;
  }

  .order-nav-back {
    margin-bottom: 25px;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--brand);
    transition: color 0.25s var(--ease);
  }

  .btn-back:hover {
    color: var(--brand-lt);
  }

  .order-header-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--g-line);
    padding-bottom: 20px;
  }

  .order-header-card h1 {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(24px, 4vw, 36px);
    text-transform: uppercase;
    font-weight: 800;
    color: var(--surface);
    margin: 0;
  }

  .order-meta-info {
    font-size: 14px;
    color: var(--paper-2);
    margin-top: 6px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .order-meta-info span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Cancellation Banner */
  .cancelled-banner {
    background: #fff0f0;
    border: 1px solid rgba(217, 56, 56, 0.2);
    border-radius: var(--r-sm);
    padding: 16px 20px;
    color: #d93838;
    margin-bottom: 30px;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Order Status Progress Timeline */
  .order-status-tracker {
    margin-bottom: 40px;
    padding: 30px 20px;
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid var(--g-line);
    border-radius: var(--r-sm);
  }

  .tracker-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
    gap: 10px;
  }

  .tracker-progress-line {
    position: absolute;
    top: 20px;
    left: 12.5%;
    right: 12.5%;
    height: 4px;
    background: rgba(75, 58, 143, 0.1);
    z-index: 0;
  }

  .tracker-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand), var(--accent));
    width: 0%;
    transition: width 0.6s ease;
  }

  .tracker-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid rgba(75, 58, 143, 0.15);
    display: grid;
    place-items: center;
    color: var(--paper-3);
    transition: all 0.3s ease;
  }

  .tracker-step.completed .step-icon-circle {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    box-shadow: 0 0 0 4px rgba(75, 58, 143, 0.15);
  }

  .tracker-step.current .step-icon-circle {
    background: #fff;
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 0 4px rgba(184, 112, 28, 0.2);
  }

  .step-label {
    margin-top: 12px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--paper-3);
  }

  .tracker-step.completed .step-label {
    color: var(--brand);
  }

  .tracker-step.current .step-label {
    color: var(--accent);
  }

  .step-time {
    font-size: 10px;
    color: var(--paper-3);
    margin-top: 2px;
  }

  /* Two Column Details Grid */
  .order-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 990px) {
    .order-details-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  /* Items Table/List */
  .order-card-header {
    font-family: 'Outfit', sans-serif;
    text-transform: uppercase;
    font-size: 16px;
    font-weight: 800;
    color: var(--brand);
    border-bottom: 1px solid var(--g-line);
    padding-bottom: 12px;
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .line-items-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .line-item-row {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 16px;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(75, 58, 143, 0.08);
  }

  .line-item-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .line-item-thumb {
    width: 70px;
    height: 70px;
    background: rgba(75, 58, 143, 0.06);
    border-radius: var(--r-sm);
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .line-item-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .line-item-details {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .line-item-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--surface);
    margin: 0;
  }

  .line-item-meta {
    font-size: 12px;
    color: var(--paper-3);
  }

  .line-item-price-qty {
    font-size: 13px;
    color: var(--paper-2);
    margin-top: 2px;
  }

  .line-item-subtotal {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--surface);
    text-align: right;
  }

  /* Financial Breakdown Card */
  .cost-summary-card {
    background: rgba(75, 58, 143, 0.03);
    border-radius: var(--r-sm);
    padding: 20px;
    margin-top: 25px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--paper-2);
  }

  .summary-row.discount-row {
    color: #1e7e34;
    font-weight: 600;
  }

  .summary-row.total-row {
    border-top: 1px solid var(--g-line);
    padding-top: 12px;
    margin-top: 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--surface);
    font-family: 'Outfit', sans-serif;
  }

  /* Billing & Shipping Side Info Cards */
  .address-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .address-card {
    background: var(--g-bg);
    border: 1px solid var(--g-line);
    border-radius: var(--r);
    padding: 24px;
    box-shadow: var(--g-shadow);
  }

  .address-card-header {
    font-family: 'Outfit', sans-serif;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 800;
    color: var(--brand);
    border-bottom: 1px solid var(--g-line);
    padding-bottom: 10px;
    margin-bottom: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .address-status-badge {
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
  }

  .address-content {
    font-size: 14px;
    line-height: 1.5;
    color: var(--paper-2);
  }

  .tracking-block {
    margin-top: 16px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.4);
    border-radius: var(--r-sm);
    border: 1px dashed var(--g-line);
    font-size: 13px;
  }

  .tracking-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .tracking-btn:hover {
    color: var(--accent-2);
  }
</style>

<div class="customer-order-container">
  <!-- Back button -->
  <div class="order-nav-back">
    <a href="{{ routes.account_url }}" class="btn-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {{ 'customer.account.return' | t }}
    </a>
  </div>

  <!-- Header Section -->
  <div class="order-header-card">
    <div>
      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
      <div class="order-meta-info">
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {{ order.created_at | time_tag: format: 'date_at_time' }}
        </span>
      </div>
    </div>
  </div>

  <!-- Cancelled Banner if applicable -->
  {% if order.cancelled %}
    <div class="cancelled-banner">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px; flex-shrink: 0;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <div>
        <strong>Order Cancelled</strong> - Placed on {{ order.created_at | time_tag: format: 'date' }}.
        {% if order.cancelled_reason %}
          Reason: {{ order.cancelled_reason_label }}
        {% endif %}
      </div>
    </div>
  {% else %}
    <!-- Order Status Tracker -->
    <div class="order-status-tracker">
      <div class="tracker-steps">
        <!-- Progress fill line calculations -->
        {%- assign progress_pct = 0 -%}
        {%- if order.fulfillment_status == 'fulfilled' -%}
          {%- assign progress_pct = 100 -%}
        {%- elsif order.fulfillment_status == 'partial' -%}
          {%- assign progress_pct = 66 -%}
        {%- elsif order.financial_status == 'paid' or order.financial_status == 'partially_paid' -%}
          {%- assign progress_pct = 33 -%}
        {%- endif -%}

        <div class="tracker-progress-line">
          <div class="tracker-progress-fill" style="width: {{ progress_pct }}%;"></div>
        </div>

        <!-- Step 1: Ordered -->
        <div class="tracker-step completed">
          <div class="step-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <span class="step-label">Ordered</span>
        </div>

        <!-- Step 2: Paid/Processing -->
        {%- assign is_paid = false -%}
        {%- if order.financial_status == 'paid' or order.financial_status == 'partially_paid' or order.financial_status == 'authorized' -%}
          {%- assign is_paid = true -%}
        {%- endif -%}
        <div class="tracker-step {% if is_paid or order.fulfillment_status == 'fulfilled' %}completed{% else %}current{% endif %}">
          <div class="step-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <span class="step-label">Processing</span>
        </div>

        <!-- Step 3: Dispatched -->
        {%- assign is_dispatched = false -%}
        {%- if order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' -%}
          {%- assign is_dispatched = true -%}
        {%- endif -%}
        <div class="tracker-step {% if is_dispatched %}completed{% elsif is_paid %}current{% endif %}">
          <div class="step-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <span class="step-label">Dispatched</span>
        </div>

        <!-- Step 4: Delivered -->
        {%- assign is_delivered = false -%}
        {%- if order.fulfillment_status == 'fulfilled' -%}
          {%- assign is_delivered = true -%}
        {%- endif -%}
        <div class="tracker-step {% if is_delivered %}completed{% elsif is_dispatched %}current{% endif %}">
          <div class="step-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <span class="step-label">Delivered</span>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Details Layout -->
  <div class="order-details-grid">
    <!-- Items table card -->
    <div class="glass-card">
      <h2 class="order-card-header">
        <span>Items Ordered</span>
        <span>{{ order.line_items.size }} {{ order.line_items.size | pluralize: 'item', 'items' }}</span>
      </h2>

      <div class="line-items-list">
        {% for line_item in order.line_items %}
          <div class="line-item-row">
            <!-- Thumbnail Resolver -->
            <div class="line-item-thumb">
              {% if line_item.image != blank %}
                <img src="{{ line_item.image | image_url: width: 150 }}" alt="{{ line_item.title }}" loading="lazy" width="70" height="70">
              {% else %}
                {%- liquid
                  assign resolved_img_name = nil
                  assign handle_down = line_item.product.handle | downcase
                  assign title_down = line_item.title | downcase
                  
                  if handle_down contains "kitchen" or title_down contains "kitchen"
                    assign resolved_img_name = "purelane-kitchen.png"
                  elsif handle_down contains "dish" or title_down contains "dish"
                    assign resolved_img_name = "purelane-dish.png"
                  elsif handle_down contains "tap" or title_down contains "tap" or handle_down contains "limescale" or title_down contains "limescale"
                    assign resolved_img_name = "purelane-tap.png"
                  elsif handle_down contains "laundry" or title_down contains "laundry"
                    assign resolved_img_name = "purelane-laundry.png"
                  elsif handle_down contains "conditioner" or title_down contains "conditioner"
                    assign resolved_img_name = "purelane-conditioner.png"
                  elsif handle_down contains "washing" or handle_down contains "machine" or title_down contains "washing" or title_down contains "machine"
                    assign resolved_img_name = "purelane-wm.png"
                  elsif handle_down contains "toilet" or title_down contains "toilet"
                    assign resolved_img_name = "purelane-toilet.png"
                  elsif handle_down contains "floor" or title_down contains "floor"
                    assign resolved_img_name = "purelane-floor.png"
                  elsif handle_down contains "hand" or title_down contains "hand"
                    assign resolved_img_name = "purelane-handwash.png"
                  elsif handle_down contains "eraser" or title_down contains "eraser"
                    assign resolved_img_name = "purelane-eraser.png"
                  endif
                -%}
                {% if resolved_img_name != blank %}
                  <img src="{{ resolved_img_name | asset_url }}" alt="{{ line_item.title }}" loading="lazy" width="70" height="70">
                {% else %}
                  <span style="background: var(--brand); color:#fff; width:100%; height:100%; border-radius:8px; display:grid; place-items:center; font-family:'Outfit'; font-size:10px; font-weight:800;">PL</span>
                {% endif %}
              {% endif %}
            </div>

            <!-- Details -->
            <div class="line-item-details">
              <h3 class="line-item-title">{{ line_item.product.title | default: line_item.title }}</h3>
              {%- if line_item.variant.title != 'Default Title' -%}
                <span class="line-item-meta">{{ line_item.variant.title }}</span>
              {%- endif -%}
              {%- if line_item.sku != blank -%}
                <span class="line-item-meta" style="letter-spacing: 0.05em;">SKU: {{ line_item.sku }}</span>
              {%- endif -%}
              <span class="line-item-price-qty">{{ line_item.final_price | money_without_trailing_zeros }} x {{ line_item.quantity }}</span>
            </div>

            <!-- Subtotal -->
            <div class="line-item-subtotal">
              {{ line_item.final_line_price | money_without_trailing_zeros }}
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Cost Breakdown Summary -->
      <div class="cost-summary-card">
        <div class="summary-row">
          <span>Subtotal</span>
          <span>{{ order.line_items_subtotal_price | money_without_trailing_zeros }}</span>
        </div>

        {%- for discount_application in order.cart_level_discount_applications -%}
          <div class="summary-row discount-row">
            <span>Discount ({{ discount_application.title }})</span>
            <span>-{{ discount_application.total_allocated_amount | money_without_trailing_zeros }}</span>
          </div>
        {%- endfor -%}

        {%- for shipping_method in order.shipping_methods -%}
          <div class="summary-row">
            <span>Shipping ({{ shipping_method.title }})</span>
            <span>{{ shipping_method.price | money_without_trailing_zeros }}</span>
          </div>
        {%- endfor -%}

        {%- for tax_line in order.tax_lines -%}
          <div class="summary-row">
            <span>Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
            <span>{{ tax_line.price | money_without_trailing_zeros }}</span>
          </div>
        {%- endfor -%}

        <div class="summary-row total-row">
          <span>Total</span>
          <span>{{ order.total_price | money_without_trailing_zeros }}</span>
        </div>
      </div>
    </div>

    <!-- Side details (shipping & billing addresses) -->
    <div class="address-cards-stack">
      <!-- Shipping Address -->
      <div class="address-card">
        <h2 class="address-card-header">
          <span>Shipping Address</span>
          {%- assign f_status = order.fulfillment_status -%}
          <span class="address-status-badge badge-{{ f_status }}">
            {{ order.fulfillment_status_label }}
          </span>
        </h2>
        <div class="address-content">
          {{ order.shipping_address | format_address }}
        </div>

        <!-- Tracking details if fulfilled -->
        {% if order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' %}
          {% for line_item in order.line_items %}
            {% if line_item.fulfillment.tracking_number %}
              <div class="tracking-block">
                <strong>Tracking ({{ line_item.fulfillment.tracking_company }})</strong><br>
                Number: {{ line_item.fulfillment.tracking_number }}
                {% if line_item.fulfillment.tracking_url %}
                  <br>
                  <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" class="tracking-btn">
                    Track Shipment
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 12px; height: 12px;">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                {% endif %}
              </div>
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

      <!-- Billing Address -->
      <div class="address-card">
        <h2 class="address-card-header">
          <span>Billing Address</span>
          {%- assign f_status = order.financial_status -%}
          <span class="address-status-badge badge-{{ f_status }}">
            {{ order.financial_status_label }}
          </span>
        </h2>
        <div class="address-content">
          {{ order.billing_address | format_address }}
        </div>
      </div>
    </div>
  </div>
</div>
