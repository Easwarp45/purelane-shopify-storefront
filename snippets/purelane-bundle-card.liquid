{% comment %}
  Renders a Purelane bundle category card.
  Accepts:
  - title: {String} Title of the category
  - description: {String} Description/subtext
  - link: {String} Target URL for the card
  - image: {Image} Shopify Image object (optional)
  - fallback_class: {String} Fallback prototype CSS class (e.g. "p-kitchen") (optional)
  - delay_class: {String} CSS delay class (e.g., "rv-d1", "rv-d2") (optional)
{% endcomment %}

<a class="glass cat rv {{ delay_class }}" href="{{ link | default: '#combos' }}">
  <span class="ph">
    {%- if image != blank -%}
      <img src="{{ image | image_url: width: 250 }}" class="pimg" alt="{{ title | escape }}" loading="lazy" style="height: 176px; width: auto; object-fit: contain; position: relative;">
    {%- else -%}
      <span class="pimg {{ fallback_class | default: 'p-kitchen' }}" role="img" aria-label="{{ title | escape }}"></span>
    {%- endif -%}
  </span>
  <span class="txt">
    <h4>{{ title }}</h4>
    <p>{{ description }}</p>
  </span>
</a>
