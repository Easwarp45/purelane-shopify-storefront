{% comment %}
  Renders a Purelane custom product card.
  Accepts:
  - card_product: {Object} Product object (required)
{% endcomment %}

{%- if card_product != blank -%}
  {%- liquid
    assign price = card_product.price
    assign compare_at_price = card_product.compare_at_price
    assign discount = 0
    if compare_at_price > price
      assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
    endif

    assign product_badge = ""
    for tag in card_product.tags
      if tag contains 'badge:'
        assign product_badge = tag | split: ':' | last
      endif
    endfor
  -%}
  <article class="glass card rv">
    <a href="{{ card_product.url }}" class="card-link-wrapper" style="display: block; color: inherit; text-decoration: none;">
      <div class="shot">
        {%- if product_badge != blank -%}
          <span class="pill">{{ product_badge }}</span>
        {%- else -%}
          {%- if compare_at_price > price -%}
            <span class="pill">Sale</span>
          {%- endif -%}
        {%- endif -%}
        {%- liquid
          assign is_resolved_image = false
          assign resolved_img_name = nil

          if card_product.featured_image != blank
            assign is_resolved_image = true
            assign resolved_img_url = card_product.featured_image | image_url: width: 300
            assign resolved_img_w = card_product.featured_image.width
            assign resolved_img_h = card_product.featured_image.height
          else
            # Try to match the handle/title to one of our AI brand assets
            assign handle_down = card_product.handle | downcase
            assign title_down = card_product.title | downcase
            
            if handle_down contains "kitchen" or title_down contains "kitchen"
              assign resolved_img_name = "purelane-kitchen.png"
            elsif handle_down contains "dish" or title_down contains "dish"
              assign resolved_img_name = "purelane-dish.png"
            elsif handle_down contains "tap" or title_down contains "tap" or handle_down contains "limescale" or title_down contains "limescale"
              assign resolved_img_name = "purelane-tap.png"
            elsif handle_down contains "laundry" or title_down contains "laundry"
              assign resolved_img_name = "purelane-laundry.png"
            elsif handle_down contains "conditioner" or title_down contains "conditioner"
              assign resolved_img_name = "purelane-conditioner.png"
            elsif handle_down contains "washing" or handle_down contains "machine" or title_down contains "washing" or title_down contains "machine"
              assign resolved_img_name = "purelane-wm.png"
            elsif handle_down contains "toilet" or title_down contains "toilet"
              assign resolved_img_name = "purelane-toilet.png"
            elsif handle_down contains "floor" or title_down contains "floor"
              assign resolved_img_name = "purelane-floor.png"
            elsif handle_down contains "hand" or title_down contains "hand"
              assign resolved_img_name = "purelane-handwash.png"
            elsif handle_down contains "eraser" or title_down contains "eraser"
              assign resolved_img_name = "purelane-eraser.png"
            endif

            if resolved_img_name != blank
              assign is_resolved_image = true
              assign resolved_img_url = resolved_img_name | asset_url
              assign resolved_img_w = 300
              assign resolved_img_h = 375
            endif
          endif
        -%}

        {%- if is_resolved_image -%}
          <img 
            src="{{ resolved_img_url }}" 
            class="pimg" 
            alt="{{ card_product.title | escape }}" 
            loading="lazy"
            width="{{ resolved_img_w }}"
            height="{{ resolved_img_h }}"
            style="height: 122px; width: auto; object-fit: contain;"
          >
        {%- else -%}
          <span class="pimg p-kitchen" role="img" aria-label="{{ card_product.title | escape }}" style="height: 122px; width: 100%; display: block;"></span>
        {%- endif -%}
      </div>
    </a>
    
    <h4 style="margin-top: 10px;"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h4>
    
    <div class="rate">
      <b>★ {% if card_product.metafields.reviews.rating.value %}{{ card_product.metafields.reviews.rating.value }}{% else %}4.8{% endif %}</b> 
      · {% if card_product.metafields.reviews.rating_count.value %}{{ card_product.metafields.reviews.rating_count.value }}{% else %}250{% endif %} reviews
    </div>
    
    <div class="pr">
      <strong>{{ price | money_without_trailing_zeros }}</strong>
      {%- if compare_at_price > price -%}
        <s>{{ compare_at_price | money_without_trailing_zeros }}</s>
        <em>{{ discount }}% off</em>
      {%- endif -%}
    </div>
    
    {%- form 'product', card_product, id: nil, class: 'purelane-add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ card_product.first_available_variant.id }}">
      <button type="submit" class="btn btn-ghost btn-sm" style="width: 100%; justify-content: center;" {% unless card_product.available %}disabled{% endunless %}>
        {%- if card_product.available -%}
          Add to cart
        {%- else -%}
          Sold out
        {%- endif -%}
      </button>
    {%- endform -%}
  </article>
{%- endif -%}
