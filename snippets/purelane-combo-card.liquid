          endif
        -%}
        <div class="plus">+</div>
        <div class="it">
          {%- if p4_url != blank -%}
            <img src="{{ p4_url }}" class="pimg" alt="{{ product_4_label | escape }}" loading="lazy" width="{{ p4_w }}" height="{{ p4_h }}" style="height: 66px; width: auto; object-fit: contain; margin: 0 auto 8px;">
          {%- else -%}
