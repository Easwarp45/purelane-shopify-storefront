{% comment %}
  Renders a Purelane combo card.
  Accepts:
  - title: {String} Title of the combo
  - products_count: {Number} Number of products in the combo
  - benefits: {String} Bulleted list of benefits separated by middle dots
  - price: {Number} Current price (e.g., 499)
  - compare_at_price: {Number} Compare-at price (e.g., 897)
  - savings: {String} Savings text (e.g., "Save ₹398")
  - badge: {String} Optional badge (e.g., "Most popular")
  - is_hero: {Boolean} Whether this is the highlighted card
  - product_1_image: {Image} Shopify Image object (optional)
  - product_1_class: {String} Prototype CSS class if no image (optional)
  - product_1_label: {String} Product label (optional)
  - product_2_image: {Image} Shopify Image object (optional)
  - product_2_class: {String} Prototype CSS class if no image (optional)
  - product_2_label: {String} Product label (optional)
  - product_3_image: {Image} Shopify Image object (optional)
  - product_3_class: {String} Prototype CSS class if no image (optional)
  - product_3_label: {String} Product label (optional)
  - product_4_image: {Image} Shopify Image object (optional)
  - product_4_class: {String} Prototype CSS class if no image (optional)
  - product_4_label: {String} Product label (optional)
  - product_5_image: {Image} Shopify Image object (optional)
  - product_5_class: {String} Prototype CSS class if no image (optional)
  - product_5_label: {String} Product label (optional)
  - button_link: {String} URL for the CTA button
  - button_label: {String} Text for the CTA button
{% endcomment %}

<div class="glass combo{% if is_hero %} hero-combo{% endif %} rv">
  <div class="tray">
    {%- if savings != blank -%}
      <span class="save">{{ savings }}</span>
    {%- endif -%}
    {%- if badge != blank -%}
      <span class="flag">{{ badge }}</span>
    {%- endif -%}
    
    <div class="stack">
      {%- if product_1_label != blank or product_1_class != blank or product_1_image != blank -%}
        {%- liquid
          assign p1_url = nil
          if product_1_image != blank
            assign p1_url = product_1_image | image_url: width: 120
            assign p1_w = product_1_image.width
            assign p1_h = product_1_image.height
          else
            if product_1_class == 'p-kitchen' or product_1_class == 'p-combo2'
              assign p1_url = 'purelane-kitchen.png' | asset_url
            elsif product_1_class == 'p-dish'
              assign p1_url = 'purelane-dish.png' | asset_url
            elsif product_1_class == 'p-tap'
              assign p1_url = 'purelane-tap.png' | asset_url
            elsif product_1_class == 'p-laundry'
              assign p1_url = 'purelane-laundry.png' | asset_url
            elsif product_1_class == 'p-wm'
              assign p1_url = 'purelane-wm.png' | asset_url
            elsif product_1_class == 'p-toilet'
              assign p1_url = 'purelane-toilet.png' | asset_url
            elsif product_1_class == 'p-floor'
              assign p1_url = 'purelane-floor.png' | asset_url
            elsif product_1_class == 'p-handwash'
              assign p1_url = 'purelane-handwash.png' | asset_url
            elsif product_1_class == 'p-eraser'
              assign p1_url = 'purelane-eraser.png' | asset_url
            endif
            assign p1_w = 120
            assign p1_h = 150
          endif
        -%}
        <div class="it">
          {%- if p1_url != blank -%}
            <img src="{{ p1_url }}" class="pimg" alt="{{ product_1_label | escape }}" loading="lazy" width="{{ p1_w }}" height="{{ p1_h }}" style="height: 66px; width: auto; object-fit: contain; margin: 0 auto 8px;">
          {%- else -%}
            <span class="pimg {{ product_1_class }}" role="img" aria-label="{{ product_1_label | escape }}"></span>
          {%- endif -%}
          <span>{{ product_1_label }}</span>
        </div>
      {%- endif -%}
      
      {%- if product_2_label != blank or product_2_class != blank or product_2_image != blank -%}
        {%- liquid
          assign p2_url = nil
          if product_2_image != blank
